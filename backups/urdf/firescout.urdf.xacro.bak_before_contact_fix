<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="firescout_fs01">
  <!-- Coordinate convention: X forward, Y left, Z upward. Origin at floor. -->
  <xacro:property name="wheel_r" value="0.07"/>
  <xacro:property name="wheel_sep" value="0.31"/>
  <material name="red"><color rgba="0.73 0.10 0.10 1"/></material>
  <material name="black"><color rgba="0.10 0.12 0.15 1"/></material>
  <material name="yellow"><color rgba="0.98 0.68 0.05 1"/></material>
  <material name="blue"><color rgba="0.16 0.56 0.72 1"/></material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0.155"/><mass value="8.8"/><inertia ixx="0.128" ixy="0" ixz="0" iyy="0.231" iyz="0" izz="0.295"/></inertial>
    <visual><origin xyz="0 0 0.155"/><geometry><box size="0.50 0.28 0.13"/></geometry><material name="red"/></visual>
    <collision><origin xyz="0 0 0.155"/><geometry><box size="0.50 0.28 0.13"/></geometry></collision>
  </link>
  <link name="top_panel"><visual><origin xyz="0 0 0"/><geometry><box size="0.36 0.23 0.012"/></geometry><material name="black"/></visual></link>
  <joint name="top_panel_joint" type="fixed"><parent link="base_link"/><child link="top_panel"/><origin xyz="-0.025 0 0.225"/></joint>
  <xacro:macro name="wheel" params="side sign">
    <link name="${side}_wheel_link">
      <inertial><mass value="0.45"/><inertia ixx="0.0013" ixy="0" ixz="0" iyy="0.0013" iyz="0" izz="0.0013"/></inertial>
      <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_r}" length="0.035"/></geometry><material name="black"/></visual>
      <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="${wheel_r}" length="0.035"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel_link"/><origin xyz="0.03 ${sign * wheel_sep/2} 0.07"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel side="left" sign="1"/>
  <xacro:wheel side="right" sign="-1"/>
  <!-- Simplified spherical rear support. Friction tuned for first simulation. -->
  <link name="caster_link">
    <inertial><mass value="0.15"/><inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/></inertial>
    <visual><geometry><sphere radius="0.025"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
  </link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.20 0 0.025"/></joint>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.055" length="0.04"/></geometry><material name="black"/></visual>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.26"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.037 0.065 0.037"/></geometry><material name="black"/></visual></link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.255 0 0.18" rpy="0 0.10 0"/></joint>
  <link name="imu_link"><visual><geometry><box size="0.035 0.035 0.015"/></geometry><material name="blue"/></visual></link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.16"/></joint>
  <link name="bumper_link">
    <visual><geometry><box size="0.03 0.295 0.035"/></geometry><material name="yellow"/></visual>
    <collision><geometry><box size="0.03 0.295 0.035"/></geometry></collision>
  </link>
  <joint name="bumper_joint" type="fixed"><parent link="base_link"/><child link="bumper_link"/><origin xyz="0.265 0 0.125"/></joint>
  <gazebo reference="base_link"><material>Gazebo/Red</material></gazebo>
  <gazebo reference="caster_link"><mu1>0.02</mu1><mu2>0.02</mu2></gazebo>
  <gazebo reference="left_wheel_link"><mu1>1.1</mu1><mu2>1.1</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.1</mu1><mu2>1.1</mu2></gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation><wheel_radius>${wheel_r}</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="scan" type="gpu_lidar"><pose>0 0 0.06 0 0 0</pose><always_on>true</always_on><update_rate>8</update_rate><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.10</min><max>8.0</max><resolution>0.01</resolution></range></lidar>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/camera/image_raw</topic><gz_frame_id>camera_link</gz_frame_id>
      <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>15</far></clip></camera>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link"><sensor name="imu" type="imu"><always_on>true</always_on><update_rate>50</update_rate><topic>/imu/data</topic><gz_frame_id>imu_link</gz_frame_id></sensor></gazebo>
  <gazebo reference="bumper_link"><sensor name="front_contact" type="contact"><always_on>true</always_on><update_rate>20</update_rate><topic>/bumper/contacts</topic><contact><collision>bumper_link_fixed_joint_lump__bumper_link_collision</collision></contact></sensor></gazebo>
</robot>
